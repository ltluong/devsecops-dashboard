import { useState } from "react";

import { useNavigate }
from "react-router-dom";
import GatesDashboard from "./components/GatesDashboard";
function App() {

  const navigate =
    useNavigate();

  const [repoUrl, setRepoUrl] =
    useState("");

  const [scanning, setScanning] =
    useState(false);

  const [scanData, setScanData] =
    useState(null);

  const startScan = async () => {

    try {

      setScanning(true);

      const response = await fetch(
        "http://127.0.0.1:8000/scan",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json",
          },

          body: JSON.stringify({
            repo_url: repoUrl,
          }),
        }
      );

      const data =
        await response.json();

      console.log(data);

      setScanData(data);

      setScanning(false);

    } catch (error) {

      console.log(error);

      alert("Scan failed");

      setScanning(false);
    }
  };

  return (

    <div className="min-h-screen
    bg-[#020817]
    text-white
    p-6">

      {/* HEADER */}

      <div className="bg-[#071633]
      p-6
      rounded-2xl
      shadow-xl
      mb-8">

        <h1 className="text-3xl
        font-bold
        text-cyan-300
        mb-5">

          Scan New GitHub Repository

        </h1>

        <div className="flex
        gap-4">

          <input
            type="text"

            placeholder="https://github.com/user/repo.git"

            value={repoUrl}

            onChange={(e) =>
              setRepoUrl(e.target.value)
            }

            className="flex-1
            bg-[#10203d]
            p-4
            rounded-xl
            outline-none
            text-white"
          />

          <button
            onClick={startScan}

            className="bg-cyan-500
            hover:bg-cyan-600
            px-8
            rounded-xl
            font-bold">

            {scanning
              ? "Scanning..."
              : "Start Scan"}

          </button>

        </div>

      </div>

      {/* DASHBOARD */}

      <div className="grid
      grid-cols-1
      md:grid-cols-3
      gap-6">

        {/* SONARQUBE */}

        <div className="bg-[#071633]
        rounded-2xl
        p-6
        shadow-xl">

          <h2 className="text-cyan-300
          text-3xl
          font-bold
          text-center
          mb-8">

            SonarQube Summary

          </h2>

          <div className="space-y-3
          text-center
          text-lg">

            <p>

              Total Issues:

              {" "}

              {scanData
                ? scanData.sonarqube.issues.length
                : 0}

            </p>

            <p className="text-red-400">

              Critical:

              {" "}

              {scanData
                ? scanData.sonarqube.critical
                : 0}

            </p>

            <p className="text-orange-400">

              Major:

              {" "}

              {scanData
                ? scanData.sonarqube.major
                : 0}

            </p>

            <p className="text-yellow-300">

              Minor:

              {" "}

              {scanData
                ? scanData.sonarqube.minor
                : 0}

            </p>

            <p>
              Code Smells: 91
            </p>

            <p>
              Bugs: 9
            </p>

          </div>

          <div className="flex
          justify-center">

            <button
              onClick={() =>
                navigate("/sonar-details")
              }

              className="mt-8
              bg-red-500
              hover:bg-red-600
              px-5
              py-2
              rounded-xl
              font-bold
              text-white">

              View SonarQube Details

            </button>

          </div>

          {/* RESULT */}

          <div className="bg-black
          rounded-lg
          mt-5
          p-4">

            <h3 className="text-yellow-300
            font-bold
            mb-2">

              SonarQube Scan Result

            </h3>

            <ul className="text-green-400
            text-sm
            list-disc
            pl-5">

              {scanData
                ? scanData.sonarqube.issues.map(
                    (issue, index) => (

                      <li key={index}>

                        {issue.message}

                      </li>
                    )
                  )

                : null}

            </ul>

          </div>

        </div>

        {/* SNYK */}

        <div className="bg-[#071633]
        rounded-2xl
        p-6
        shadow-xl">

          <h2 className="text-cyan-300
          text-3xl
          font-bold
          text-center
          mb-8">

            Snyk Vulnerabilities

          </h2>

          <div className="space-y-3
          text-center
          text-lg">

            <p className="text-red-400">
              Critical: 24
            </p>

            <p className="text-orange-400">
              High: 124
            </p>

            <p className="text-yellow-300">
              Medium: 231
            </p>

            <p>
              Total: 379
            </p>

          </div>

          <div className="flex
          justify-center">

            <button
              onClick={() =>
                navigate("/snyk-details")
              }

              className="mt-8
              bg-pink-500
              hover:bg-pink-600
              px-5
              py-2
              rounded-xl
              font-bold
              text-white">

              View Snyk Details

            </button>

          </div>

          <div className="bg-black
          rounded-lg
          mt-5
          p-4">

            <h3 className="text-pink-400
            font-bold
            mb-2">

              Snyk Scan Result

            </h3>

            <ul className="text-pink-300
            text-sm
            list-disc
            pl-5">

              <li>Prototype Pollution</li>

              <li>Remote Code Execution</li>

            </ul>

          </div>

        </div>

        {/* TRIVY */}

        <div className="bg-[#071633]
        rounded-2xl
        p-6
        shadow-xl">

          <h2 className="text-cyan-300
          text-3xl
          font-bold
          text-center
          mb-8">

            Trivy Vulnerabilities

          </h2>

          <div className="space-y-3
          text-center
          text-lg">

            <p className="text-red-400">
              Critical: 0
            </p>

            <p className="text-orange-400">
              High: 6
            </p>

            <p className="text-yellow-300">
              Medium: 16
            </p>

            <p>
              Total: 23
            </p>

          </div>

          <div className="flex
          justify-center">

            <button
              onClick={() =>
                navigate("/trivy-details")
              }

              className="mt-8
              bg-green-500
              hover:bg-green-600
              px-5
              py-2
              rounded-xl
              font-bold
              text-white">

              View Trivy Details

            </button>

          </div>

          <div className="bg-black
          rounded-lg
          mt-5
          p-4">

            <h3 className="text-green-400
            font-bold
            mb-2">

              Trivy Scan Result

            </h3>

            <ul className="text-green-300
            text-sm
            list-disc
            pl-5">

              <li>OpenSSL CVE</li>

              <li>Alpine Linux CVE</li>

            </ul>

          </div>

        </div>

      </div>
      <GatesDashboard />
    </div>
  );
}

export default App;
